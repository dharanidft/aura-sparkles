# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="UPI Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use 'error' in production to avoid leaking debug info.
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=upi_gateway
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=upi_gateway
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true in production — encrypts session data at rest.
SESSION_ENCRYPT=false
# Set to true when deployed on HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=database

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Gateway ──────────────────────────────────────────────────────────────────
# Minutes a payment link stays valid.
GATEWAY_ORDER_EXPIRY_MINUTES=15

# Set to true ONLY for local dev to allow http:// webhook URLs.
GATEWAY_WEBHOOK_ALLOW_INSECURE=false

# Set to true ONLY for local dev to allow http:// redirect URLs.
GATEWAY_ALLOW_INSECURE_REDIRECTS=false

# Set to false to switch CSP to report-only mode (useful during deployment rollout).
GATEWAY_CSP_ENFORCE=true

# Paytm for Business status endpoint (unofficial).
# PAYTM_STATUS_URL=https://securegw.paytm.in/merchant-status/getTxnStatus

# Paytm Payment Gateway base URLs.
# PAYTM_PG_SANDBOX_URL=https://securestage.paytmpayments.com
# PAYTM_PG_PRODUCTION_URL=https://secure.paytmpayments.com

# ─── AWS (optional / not used by default) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
