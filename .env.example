# ==============================================================================
# AURA SPARKLES — Environment Configuration Template (.env.example)
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=https://www.aurasparkles.com
NODE_ENV=production

# ------------------------------------------------------------------------------
# Direct UPI Payment Configuration (HDFC Bank)
# ------------------------------------------------------------------------------
# 1. Enter your official HDFC Bank UPI ID:
UPI_ID=dharanidft-1@okhdfcbank

# 2. Business name displayed inside customer's UPI app (Google Pay, PhonePe, Paytm, BHIM):
UPI_MERCHANT_NAME=Aura Sparkles

# 3. Path or URL to your business QR code image:
# (Copy your official QR code into public/images/hdfc-qr.png and set /images/hdfc-qr.png here)
UPI_QR_IMAGE_URL=/images/upi-qr-placeholder.svg

# ------------------------------------------------------------------------------
# Store Administration Passcode (used to log in at /admin and authorize API requests)
# ------------------------------------------------------------------------------
ADMIN_PASSCODE=aura2026

# ------------------------------------------------------------------------------
# GoDaddy SMTP Email Configuration (optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@aurasparkles.com
SMTP_PASS=Your_GoDaddy_Email_Password_Here
TARGET_MAILBOX=contact@aurasparkles.com
SHIPPING_PICKUP_PINCODE=600095

# ------------------------------------------------------------------------------
# WhatsApp OTP Authentication Configuration
# Supported Providers: Meta WhatsApp Cloud API, MSG91, or Twilio
# (If none configured, system operates in local Dev/Test mode with on-screen OTP)
# ------------------------------------------------------------------------------

# Option A: Meta WhatsApp Cloud API (Recommended — direct via developers.facebook.com)
# 1. System User Permanent Access Token with whatsapp_business_messaging permission:
WHATSAPP_ACCESS_TOKEN=EAAG...YourPermanentAccessTokenHere
# 2. WhatsApp Phone Number ID (from WhatsApp > API Setup):
WHATSAPP_PHONE_NUMBER_ID=109876543210987
# 3. Approved Authentication Template Name (default: aura_otp_verification):
WHATSAPP_TEMPLATE_NAME=aura_otp_verification
# 4. Template Language code (e.g. en_US or en):
WHATSAPP_TEMPLATE_LANG=en_US

# Option B: MSG91 WhatsApp API (Popular Indian SMS/WhatsApp gateway)
# MSG91_AUTH_KEY=YourMsg91AuthKeyHere
# MSG91_INTEGRATED_NUMBER=919876543210
# MSG91_WHATSAPP_TEMPLATE=aura_otp

# Option C: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=YourTwilioAuthTokenHere
# TWILIO_WHATSAPP_FROM=+14155238886

# Option D: OpenWA (Self-Hosted WhatsApp Gateway — 100% Free / ₹0 per message)
# Connects to your own WhatsApp Web instance via QR scan (zero API fees)
# OPENWA_BASE_URL=http://localhost:8080
# OPENWA_API_KEY=YourOpenWaAdminApiKeyHere
# OPENWA_SESSION_ID=default

# Secret key for HMAC-SHA256 OTP cryptographic hashing & tamper protection
OTP_SECRET=aura-sparkles-otp-hmac-salt-secret-2026
SESSION_SECRET=aura-sparkles-customer-session-secret-2026

