# AURA SPARKLES — Environment Configuration Example

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Razorpay Payment Gateway (Live or Test Credentials from dashboard.razorpay.com)
# When omitted, store automatically operates in fully functional development/demo test mode
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# Admin Dashboard Access
ADMIN_PASSCODE=aura2026

# Transactional Email Provider (Resend / SendGrid / Postmark)
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM=orders@aurasparkles.in

# Shipping Logistics API (e.g. Delhivery / Shiprocket / BlueDart)
SHIPPING_CARRIER_API_KEY=
SHIPPING_PICKUP_PINCODE=560038
